From c26e20406560cabb3257bda3ffa2959d5d5b7d28 Mon Sep 17 00:00:00 2001
From: BrianCassriel <bccassriel@gmail.com>
Date: Mon, 31 Aug 2026 23:14:05 -0700
Subject: [PATCH] Fix compilation on non-x86_64 targets

greedy.rs used is_x86_feature_detected!("avx2"), #[target_feature(enable
= "avx2")], and std::arch::x86_64 imports with no architecture gate. This
is not a runtime CPU-support problem: the crate fails to *compile* on any
non-x86_64 target, so bedrock_level cannot be built on Apple Silicon or
ARM Linux at all.

Gates the AVX-2 detection branch and both target_feature functions behind
cfg(target_arch = "x86_64"), falling back to the existing scalar
unpack_nonsimd path elsewhere. Behaviour on x86_64 is unchanged.
---
 crates/level/src/greedy.rs | 20 ++++++++++++++------
 1 file changed, 14 insertions(+), 6 deletions(-)

diff --git a/crates/level/src/greedy.rs b/crates/level/src/greedy.rs
index 8f305cbf..d4bed494 100644
--- a/crates/level/src/greedy.rs
+++ b/crates/level/src/greedy.rs
@@ -93,13 +93,19 @@ impl GreedyArray {
     pub(crate) fn unpack(words: &[u32], bits: u8) -> Self {
         let mut array = Box::new([0u16; 4096]);
 
-        if is_x86_feature_detected!("avx2") {
-            // Safety: The condition above ensures that the host supports AVX-2. Therefore this function is safe to call.
-            unsafe { Self::unpack_avx(bits, words, &mut array) };
-        } else {
-            // Fall back to regular implementation if AVX-2 is not supported.
-            Self::unpack_nonsimd(bits, words, array.as_mut());
+        #[cfg(target_arch = "x86_64")]
+        {
+            if is_x86_feature_detected!("avx2") {
+                // Safety: The condition above ensures that the host supports AVX-2. Therefore this function is safe to call.
+                unsafe { Self::unpack_avx(bits, words, &mut array) };
+            } else {
+                // Fall back to regular implementation if AVX-2 is not supported.
+                Self::unpack_nonsimd(bits, words, array.as_mut());
+            }
         }
+        // The AVX-2 path does not exist off x86_64; the scalar path is the only path.
+        #[cfg(not(target_arch = "x86_64"))]
+        Self::unpack_nonsimd(bits, words, array.as_mut());
 
         Self { array }
     }
@@ -114,6 +120,7 @@ impl GreedyArray {
     ///
     /// This function panics if `words` is too small for `bits`. In other words, `words.len() >= 4096 / (32 / bits)`.
     /// Furthermore, `BITS` must be valid, i.e. it is either 1, 2, 3, 4, 5, 6, 8 or 16.
+    #[cfg(target_arch = "x86_64")]
     #[target_feature(enable = "avx2")]
     pub fn unpack_avx(bits: u8, words: &[u32], indices: &mut [u16; 4096]) {
         // Bits are compile-time constants using generics to enable more bitsize-specific optimisations.
@@ -191,6 +198,7 @@ impl GreedyArray {
     /// This function panics if `words` is too small for `BITS`. In other words, `words.len() >= 4096 / (32 / BITS)`.
     /// Furthermore, `BITS` must be valid, i.e. it is either 1, 2, 4, 8 or 16.
     #[inline]
+    #[cfg(target_arch = "x86_64")]
     #[target_feature(enable = "avx2")]
     pub fn unpack_oct<const BITS: u8>(mut words: &[u32], indices: &mut [u16; 4096]) {
         use std::arch::x86_64::{
