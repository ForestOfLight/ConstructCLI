From 53e8bbca787310874d06b7710cd4e7b797d827d6 Mon Sep 17 00:00:00 2001
From: BrianCassriel <bccassriel@gmail.com>
Date: Mon, 31 Aug 2026 23:13:19 -0700
Subject: [PATCH] Fix the vendored C/C++ build on macOS and on non-x86 targets

Two portability defects in the vendored sources, each of which alone breaks the
build:

- port_posix_sse.cc defined LEVELDB_PLATFORM_POSIX_SSE unconditionally and
  then guarded the x86 intrinsics with '#elif defined(__GNUC__)', which
  Apple clang satisfies on arm64. Building on Apple Silicon reached
  __get_cpuid and _mm_crc32_u8 on a target with neither.
- The vendored zlib's zutil.h treats TARGET_OS_MAC as classic Mac OS and
  redefines fdopen() to NULL. That macro is set on all modern Apple
  platforms, where it clobbers the SDK's real fdopen declaration.

This patch covers only ffi/leveldb/, the BSD-3-Clause and Zlib licensed C/C++.
The two matching defects in the Rust wrapper's build.rs — linking stdc++ on
macOS, and clang's refusal to accept the vendored zlib's implicit function
declarations — are fixed in third_party/vendor/leveldb-sys/build.rs instead,
which replaces the upstream file outright.
---
 ffi/leveldb/lib/zlib/zutil.h           | 5 ++++-
 ffi/leveldb/src/port/port_posix_sse.cc | 5 +++++
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/ffi/leveldb/lib/zlib/zutil.h b/ffi/leveldb/lib/zlib/zutil.h
index b079ea6..ed2bfa5 100644
--- a/ffi/leveldb/lib/zlib/zutil.h
+++ b/ffi/leveldb/lib/zlib/zutil.h
@@ -130,7 +130,10 @@ extern z_const char * const z_errmsg[10]; /* indexed by 2-zlib_error */
 #  endif
 #endif
 
-#if defined(MACOS) || defined(TARGET_OS_MAC)
+/* TARGET_OS_MAC is set on every modern Apple platform, but this block is meant for
+   classic Mac OS only. Leaving it in redefines fdopen() to NULL and clobbers the
+   real declaration in the current SDK's <stdio.h>. */
+#if defined(MACOS)
 #  define OS_CODE  7
 #  ifndef Z_SOLO
 #    if defined(__MWERKS__) && __dest_os != __be_os && __dest_os != __win32_os
diff --git a/ffi/leveldb/src/port/port_posix_sse.cc b/ffi/leveldb/src/port/port_posix_sse.cc
index 6dbbda0..b749689 100644
--- a/ffi/leveldb/src/port/port_posix_sse.cc
+++ b/ffi/leveldb/src/port/port_posix_sse.cc
@@ -13,7 +13,12 @@
 #include <string.h>
 #include "port/port.h"
 
+// Upstream defines this unconditionally and then guards the x86 intrinsics below
+// with `#elif defined(__GNUC__)`, which Apple clang satisfies on arm64 too. The
+// result is a call to __get_cpuid/_mm_crc32_* on a target that has neither.
+#if defined(__x86_64__) || defined(__i386__) || defined(_M_X64) || defined(_M_IX86)
 #define LEVELDB_PLATFORM_POSIX_SSE
+#endif
 
 #if defined(LEVELDB_PLATFORM_POSIX_SSE)
 
-- 
